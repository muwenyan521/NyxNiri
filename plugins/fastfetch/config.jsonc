// NyxNiri · fastfetch
//
// 颜色一律用 ANSI 名字（magenta / blue / bright_black），不写十六进制：
// 深浅色主题切换时由终端调色板决定，这份配置不用跟着改。
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 2,
            "left": 3,
            "right": 6
        },
        "color": {
            "1": "magenta",
            "2": "blue"
        }
    },
    "display": {
        "separator": "  ",
        "disableLinewrap": true,
        "percent": {
            "type": ["bar"],
            "color": {
                "green": "magenta",
                "yellow": "blue",
                "red": "red"
            }
        },
        "bar": {
            "border": null,
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 12
        },
        "color": {
            "keys": "bright_black",
            "title": "magenta",
            "output": "white"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "title",
            "format": "{#magenta}{user-name}{#}{#bright_black} @ {#}{#magenta}{host-name}{#}"
        },
        {
            "type": "custom",
            "format": " {#bright_black}STAY LIBRE ── 自由であり続けろ{#}"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "custom",
            "format": " {#magenta}✦{#} {#bright_black}system{#}"
        },
        {
            "type": "os",
            "key": "   os  ",
            "format": "{3} ({12})"
        },
        {
            "type": "kernel",
            "key": "   kern",
            "format": "{2}"
        },
        {
            "type": "wm",
            "key": "   wm  ",
            "format": "{1} ({3})"
        },
        {
            "type": "terminal",
            "key": "   term"
        },
        {
            "type": "shell",
            "key": "   sh  "
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "custom",
            "format": " {#magenta}✦{#} {#bright_black}hardware{#}"
        },
        {
            "type": "cpu",
            "key": "   cpu ",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "   gpu ",
            "format": "{2}"
        },
        {
            "type": "display",
            "key": "   disp",
            "format": "{width}x{height} @{refresh-rate}Hz"
        },
        {
            "type": "memory",
            "key": "   mem "
        },
        {
            "type": "disk",
            "key": "   disk",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "custom",
            "format": " {#magenta}✦{#} {#bright_black}session{#}"
        },
        {
            "type": "uptime",
            "key": "   up  ",
            "format": "{?days}{days}d {?}{hours}h {minutes}m"
        },
        {
            "type": "packages",
            "key": "   pkgs"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "block"
        },
        {
            "type": "custom",
            "format": ""
        }
    ]
}
